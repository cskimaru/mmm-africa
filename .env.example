# ---- Site ----
SITE_DOMAIN=mmmafrica.example.org       # the public domain, DNS A record pointing at the server
ACME_EMAIL=you@example.com              # Let's Encrypt contact for certificate notices
LOG_LEVEL=INFO

# ---- Public contact details (footer and contact page) ----
CONTACT_EMAIL=
CONTACT_PHONE=

# ---- Private preview before launch ----
# true: the whole site asks for a password (user "preview", password in secrets/preview_password).
# Set to false and run `make init && make up` to launch publicly.
SITE_PREVIEW=true

# ---- Permanent address when sharing from this computer (make share) ----
# Leave empty for a free random https://….trycloudflare.com link.
PUBLIC_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Images (set by CI/CD; leave as-is to build locally) ----
REGISTRY=ghcr.io/owner/mmm-africa
IMAGE_TAG=latest

# ---- Alerts (email) ----
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com:587
SMTP_USERNAME=

# ---- Backups ----
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=0                       # 03:00 in Nairobi
BACKUP_KEEP_DAYS=30
OFFSITE_S3_ENDPOINT=                    # any S3-compatible storage, e.g. Backblaze B2 or Cloudflare R2
OFFSITE_S3_BUCKET=
OFFSITE_REMOTE=                         # any rclone remote, e.g. "gdrive:MMM Africa" (config in secrets/rclone.conf)
OFFSITE_KEEP_DAYS=90                    # encrypted backups older than this are removed from OFFSITE_REMOTE
